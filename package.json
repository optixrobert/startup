{
  "name": "startup-pos",
  "private": true,
  "version": "0.1.0",
  "description": "Gestionale bar/ristoranti con POS touch e gestione turni",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:mobile": "npm run dev -w apps/mobile",
    "dev": "concurrently -k -n API,WEB,MOBILE -c green,cyan,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:mobile\"",
    "start:api": "npm run start -w apps/api",
    "start:web": "npm run start -w apps/web",
    "start:mobile": "npm run start -w apps/mobile",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build:mobile": "npm run build -w apps/mobile"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "optixrobert",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
