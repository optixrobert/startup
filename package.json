{
  "name": "startup-pos",
  "private": true,
  "version": "0.1.0",
  "description": "Gestionale bar/ristoranti con POS touch e gestione turni",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "start:api": "npm run start -w apps/api",
    "start:web": "npm run start -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build": "npm run build:web && npm run build:api",
    "prestart": "npm run build",
    "postinstall": "npm run build",
    "start": "node apps/api/dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "optixrobert",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
